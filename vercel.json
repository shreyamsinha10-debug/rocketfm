{
  "rewrites": [
    {
      "source": "/api/v1/audio/upload",
      "destination": "http://168.144.0.100:9090/api/v1/audio/upload"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/proxy?target=:path*"
